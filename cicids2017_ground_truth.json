  "labeling_rules": {
    "simple": {
      "description": "Simple rule: any flow involving 172.16.0.1 during attack windows is ATTACK",
      "rules": [
        "If src_ip == 172.16.0.1 AND time in attack_window -> ATTACK",
        "If dst_ip == 172.16.0.1 AND time in attack_window -> ATTACK",
        "Else -> BENIGN"
      ]
    },
    "strict": {
      "description": "Strict rule: match IP, port, and time window",
      "rules": [
        "If src_ip == attacker_ip AND dst_ip == victim_ip AND dst_port == victim_port AND time in window -> ATTACK",
        "Else -> BENIGN"
      ]
    }
  }
